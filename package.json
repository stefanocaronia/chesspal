{
  "name": "chesspal",
  "version": "0.0.1",
  "description": "Play chess against an AI with a character, and learn with an AI coach: Chesspal keeps the rules, the board, the games and the memory; the AI plays, reasons and talks.",
  "type": "module",
  "bin": {
    "chesspal": "dist/cli/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "instructions"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "format": "eslint --fix . && dprint fmt",
    "lint": "eslint . && dprint check && tsc -p tsconfig.test.json && tsc -p tsconfig.core.json",
    "bench": "npm run build && node --experimental-strip-types test/bench/core.ts && node --experimental-strip-types test/bench/commands.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "chess",
    "ai",
    "chess-coach",
    "chess-teacher",
    "mcp",
    "mcp-server",
    "claude-code",
    "codex"
  ],
  "author": {
    "name": "Stefano Caronia",
    "url": "https://stefanocaronia.it"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefanocaronia/chesspal.git"
  },
  "homepage": "https://github.com/stefanocaronia/chesspal#readme",
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/parser": "^8.72.1",
    "dprint": "^0.58.0",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chess.js": "^1.4.0",
    "zod": "^4.6.7"
  }
}
